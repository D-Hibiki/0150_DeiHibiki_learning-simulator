{
  "name": "learning-infrastructure-redundancy-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:sites"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "d3-dsv": "3.0.1",
    "pure-rand": "7.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.1.2",
    "simple-statistics": "7.8.8",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/d3-dsv": "3.0.7",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
